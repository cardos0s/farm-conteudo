# ── Claude (redação, triagem e revisão) ─────────────────────────────
ANTHROPIC_API_KEY=

# ── Telegram (aprovação e alertas) ──────────────────────────────────
# Crie o bot com o @BotFather e pegue seu chat id com o @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Armazenamento público dos vídeos (Instagram exige uma URL pública) ─
# Qualquer bucket compatível com S3: Cloudflare R2 (recomendado, sem custo de saída), AWS S3, Backblaze B2.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=fabrica-conteudo
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL pública do bucket (ex.: domínio r2.dev ou domínio próprio), sem barra no final
S3_PUBLIC_URL=https://midia.suaempresa.com.br

# ── Instagram (Graph API, uma conta profissional por app) ───────────
IG_GRAPH_VERSION=v23.0
IG_COCKPIT_USER_ID=
IG_COCKPIT_TOKEN=
IG_REBANHO_USER_ID=
IG_REBANHO_TOKEN=
IG_FOCCA_USER_ID=
IG_FOCCA_TOKEN=

# ── Beehiiv (uma publicação por app) ────────────────────────────────
BEEHIIV_API_KEY=
BEEHIIV_COCKPIT_PUB_ID=
BEEHIIV_REBANHO_PUB_ID=
BEEHIIV_FOCCA_PUB_ID=

# ── Opcional ────────────────────────────────────────────────────────
# Fuso usado para a janela de publicação e os horários do cron
TZ=America/Sao_Paulo
# Caminho de um Chrome/Chromium já instalado, se o Remotion não conseguir baixar o dele
REMOTION_CHROME=

# ── Vídeos UGC com personagem de IA (npm run ugc) ───────────────────
# Voz da personagem, efeitos sonoros e transcrição da decupagem
ELEVENLABS_API_KEY=
ELEVENLABS_MODELO=eleven_v4
# Quadros da personagem (modelo de imagem) e vídeo (Kling 3) pelo OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_IMAGEM_MODELO=google/gemini-2.5-flash-image
OPENROUTER_VIDEO_MODELO=kwaivgi/kling-v3.0-std
OPENROUTER_VIDEO_RESOLUCAO=1080p
# Sincronia labial (boca acompanhando a voz). Sem ela o vídeo sai, mas a boca não bate com a fala.
# Usa o bucket S3/R2 acima para a fal buscar o vídeo e o áudio.
FAL_KEY=
FAL_LIPSYNC_MODELO=fal-ai/kling-video/lipsync/audio-to-video
