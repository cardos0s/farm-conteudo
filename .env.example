# ── Claude (redação, triagem e revisão) ─────────────────────────────
ANTHROPIC_API_KEY=

# ── Telegram (aprovação e alertas) ──────────────────────────────────
# Crie o bot com o @BotFather e pegue seu chat id com o @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Armazenamento público dos vídeos (Instagram exige uma URL pública) ─
# Qualquer bucket compatível com S3: Cloudflare R2 (recomendado, sem custo de saída), AWS S3, Backblaze B2.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=fabrica-conteudo
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL pública do bucket (ex.: domínio r2.dev ou domínio próprio), sem barra no final
S3_PUBLIC_URL=https://midia.suaempresa.com.br

# ── Instagram (uma conta profissional por app) ──────────────────────
# Só os apps ativos em verticais/ precisam de token. Hoje: só o Rebanho.
# Passo a passo no README, em "Como pegar cada credencial".
# O token vence em 60 dias, mas o bot renova sozinho a cada 7 (o renovado fica em dados/).
IG_REBANHO_TOKEN=
# Opcional: o bot descobre o ID da conta pelo token. Preencha só se usar o login pelo Facebook.
IG_REBANHO_USER_ID=
IG_COCKPIT_TOKEN=
IG_COCKPIT_USER_ID=
IG_FOCCA_TOKEN=
IG_FOCCA_USER_ID=
# Padrão: graph.instagram.com (login do Instagram, sem página do Facebook).
# Use graph.facebook.com se a conta estiver ligada a uma página e o token vier do login pelo Facebook.
IG_GRAPH_HOST=graph.instagram.com
IG_GRAPH_VERSION=v23.0

# ── Beehiiv (uma publicação por app) ────────────────────────────────
BEEHIIV_API_KEY=
BEEHIIV_COCKPIT_PUB_ID=
BEEHIIV_REBANHO_PUB_ID=
BEEHIIV_FOCCA_PUB_ID=

# ── Opcional ────────────────────────────────────────────────────────
# Fuso usado para a janela de publicação e os horários do cron
TZ=America/Sao_Paulo
# Caminho de um Chrome/Chromium já instalado, se o Remotion não conseguir baixar o dele
REMOTION_CHROME=
